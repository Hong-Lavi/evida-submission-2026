+def sample_latent(adjusted, factor, equal_groups, rng, draws):
+    """Compute each quotient variable once, then copy equal columns exactly."""
+    normals = rng.standard_normal((draws, factor.shape[1]))
+    if not equal_groups:
+        return adjusted + normals @ factor.T
+    representative = np.arange(len(adjusted))
+    for group in equal_groups:
+        representative[group] = group[0]
+    reps, lookup = np.unique(representative, return_inverse=True)
+    quotient_samples = adjusted[reps] + normals @ factor[reps].T
+    return quotient_samples[:, lookup]
+
